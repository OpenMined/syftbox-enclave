[Distribution]
Distribution=ubuntu
Release=22.04
Architecture=amd64

[Output]
Format=disk
Bootable=yes
Output=sev-test.raw
Partition=esp,root

[Packages]
Packages=
    apt
    dbus
    grub-efi-amd64-signed
    iproute2
    linux-virtual
    netplan.io
    openssh-server
    openssl
    shim-signed
    sudo
    systemd
    udev
    vim

[Content]
# copy the compiled Go binary into /usr/bin inside the image
File=main:/usr/bin/main

[Kernel]
Init=/usr/bin/main

[Build]
ToolsTree=default

